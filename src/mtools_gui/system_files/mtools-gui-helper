#!/usr/bin/env python3
"""Privileged helper for mtools_gui, run via `pkexec` as root.

This file is installed standalone to /usr/local/libexec/mtools-gui-helper
by `mtools-gui-install-helper` (see install_helper.py) and executed
directly - it is NOT imported from the app's venv, so it must stay
stdlib-only (no PySide6, no third-party packages).

CLI contract: mtools-gui-helper <op> <device> [args...]

Exit codes:
  0  success - stdout is the raw passthrough of the mtools command's stdout
  1  the underlying mtools binary itself failed - stderr passthrough raw
  2  validation rejected the call - stderr "VALIDATION_ERROR: <reason>"
  3  usage error - stderr "USAGE_ERROR: <reason>"

Security model (see project plan for the full rationale): the polkit rule
that allows this to run passwordlessly only ever authorizes THIS exact
program path - never mcopy/mdir/etc. directly. On top of that, this
script independently re-validates every call instead of trusting its
caller:
  - the target device must be an independently-confirmed *removable*
    partition that isn't a kernel-recognized non-DOS filesystem, not a
    whole disk and not an internal drive, checked two ways (lsblk AND
    /sys/block/*/removable) - a bug or compromise in one check alone
    must not be enough to touch the wrong device.
  - every argument to the DOS-image-only commands must be a "::"-prefixed
    mtools path - never a bare Unix path.
  - mcopy is the one command that legitimately takes a real Unix-side
    path (to copy to/from the local filesystem). That path is confined to
    the invoking user's home directory, their own /media and /run/media
    mount roots, or a removable volume mounted under /mnt.

Unix-side files are never read or written as root. Validating a path
and then letting root open it leaves a window (TOCTOU) in which the
caller could swap a path component for a symlink to, say, /etc/shadow.
So mcopy itself only ever sees a private staging directory that root
created and nobody else can enter (mkdtemp under /var/tmp, mode 0700),
and the Unix side of the transfer is done by a child process that has
dropped to the invoking user's uid/gid/groups (from PKEXEC_UID) - it can
only read or write what that user could anyway. The two talk through a
tar stream on a pipe:
  - local -> DOS: the user-side child packs the sources and writes the
    tar stream; root unpacks it into staging, accepting only plain files
    and directories under the expected names (no links, devices, absolute
    paths or ".."), then runs mcopy from staging onto the device.
  - DOS -> local: root runs mcopy from the device into staging, packs it
    and streams it to the user-side child, which unpacks it into the
    destination. Files therefore come out owned by the user directly,
    with no chown by root afterwards.
"""

from __future__ import annotations

import json
import os
import posixpath
import pwd
import shutil
import subprocess
import sys
import tarfile
import tempfile
import threading

ALLOWED_OPS = {
    "mdir": "/usr/bin/mdir",
    "mcopy": "/usr/bin/mcopy",
    "mdel": "/usr/bin/mdel",
    "mdeltree": "/usr/bin/mdeltree",
    "mmd": "/usr/bin/mmd",
    "mmove": "/usr/bin/mmove",
    "mren": "/usr/bin/mren",
    "mattrib": "/usr/bin/mattrib",
    "mrd": "/usr/bin/mrd",
    "mtype": "/usr/bin/mtype",
}

# Filesystems the kernel positively identifies as *not* FAT-like: reject
# only these, rather than requiring a recognized FAT fstype. A
# non-standard DOS variant (e.g. GEMDOS on Atari machines) typically
# shows up with an empty/unrecognized fstype in lsblk even though mtools
# reads it fine - it parses the FAT structures itself, independently of
# the kernel's own detection. Keep this set in sync with
# constants.NON_DOS_FSTYPES (duplicated here on purpose: this file must
# stay stdlib-only and standalone, it is not imported from the
# mtools_gui package).
NON_DOS_FSTYPES = {
    "ext2", "ext3", "ext4",
    "btrfs", "xfs", "jfs", "reiserfs", "f2fs",
    "ntfs", "hfs", "hfsplus", "apfs",
    "swap", "iso9660", "udf",
    "zfs_member", "linux_raid_member", "lvm2_member", "crypto_luks",
}

EXTRA_ALLOWED_ROOTS = ("/media", "/run/media")

# /mnt has no per-user convention (a root-owned, shared mount point), so
# instead of trusting everything below it, a path there is only accepted
# if it actually lives on a removable block device - see
# _is_on_removable_volume.
MNT_ROOT = "/mnt"

# Where root's private staging directories are created: a sticky
# directory (nobody can rename or remove root's entry in it) on disk
# rather than tmpfs, since a copy can be as large as the card.
STAGING_PARENT = "/var/tmp"

HELPER_ENV = {
    "LC_ALL": "C",
    "PATH": "/usr/bin:/bin",
    # mtools' own sanity check on the boot sector's recorded geometry
    # rejects (or, depending on version, just warns loudly on) some
    # older Atari GEMDOS disks whose BPB doesn't match what mtools
    # expects - confirmed against a real card ("Hidden (7626) does not
    # match sectors (63)"). man mtools.conf calls this out explicitly:
    # "needed to read some Atari disks which have been made with the
    # earlier ROMs, and which would not be recognized otherwise." This
    # is a FAT-structure compatibility check, unrelated to this
    # project's own device-identity validation above (removable check,
    # fstype exclusion, path confinement) - skipping it doesn't weaken
    # any of that, it only stops mtools second-guessing media this app
    # exists specifically to support. Irrelevant to (and harmless for)
    # the lsblk calls that also use this env.
    "MTOOLS_SKIP_CHECK": "1",
}

# Keep in sync with mtools_client.HELPER_TIMEOUT_SECONDS/
# HELPER_COPY_TIMEOUT_SECONDS (duplicated on purpose: this file must stay
# stdlib-only and standalone). mdir/mdel/mmd/... only ever touch
# metadata and should always be near-instant; mcopy legitimately scales
# with how much data is being moved, so it gets a much longer allowance -
# this only exists to catch a truly wedged device, not to bound ordinary
# large transfers.
MTOOLS_TIMEOUT_SECONDS = 60
MTOOLS_COPY_TIMEOUT_SECONDS = 600
LSBLK_TIMEOUT_SECONDS = 5


class ValidationError(Exception):
    pass


class UsageError(Exception):
    pass


def _lsblk_row(device: str) -> dict:
    try:
        proc = subprocess.run(
            [
                "/usr/bin/lsblk",
                "-J",
                "-o",
                "TYPE,PKNAME,RM,FSTYPE,MOUNTPOINT,TRAN",
                device,
            ],
            capture_output=True,
            text=True,
            env=HELPER_ENV,
            timeout=LSBLK_TIMEOUT_SECONDS,
        )
    except FileNotFoundError as exc:
        raise ValidationError(f"lsblk introuvable : {exc}") from exc
    except subprocess.TimeoutExpired as exc:
        raise ValidationError(f"lsblk n'a pas repondu pour {device} : {exc}") from exc
    if proc.returncode != 0:
        raise ValidationError(f"lsblk a echoue pour {device} : {proc.stderr.strip()}")
    try:
        data = json.loads(proc.stdout)
        devices = data["blockdevices"]
    except (json.JSONDecodeError, KeyError, IndexError) as exc:
        raise ValidationError(f"sortie lsblk illisible pour {device}") from exc
    if not devices:
        raise ValidationError(f"{device} inconnu de lsblk")
    return devices[0]


def _sysfs_removable(pkname: str | None) -> bool:
    if not pkname:
        return False
    path = f"/sys/block/{pkname}/removable"
    try:
        with open(path, "r") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def is_removable(row: dict, sysfs_read_fn=None) -> bool:
    """Two independent checks must both agree the device is removable."""
    if sysfs_read_fn is None:
        # NOT `sysfs_read_fn=_sysfs_removable` as the parameter's default:
        # a default value is bound once, at definition time, to whatever
        # _sysfs_removable pointed to then - a test's
        # monkeypatch.setattr(helper, "_sysfs_removable", ...) replaces
        # the module-level name afterwards, but can't reach back into an
        # already-captured default. Looking the bare name up here instead
        # resolves it fresh from the module's globals on every call, so
        # the monkeypatch is actually seen. This was invisible locally
        # (a real removable device happens to be attached as /dev/sde on
        # the dev machine, so the real, unmocked check "accidentally"
        # agreed with the test) and only surfaced on a clean CI runner
        # with no such device.
        sysfs_read_fn = _sysfs_removable
    lsblk_says_removable = row.get("rm") is True
    sysfs_says_removable = sysfs_read_fn(row.get("pkname"))
    return lsblk_says_removable and sysfs_says_removable


def validate_device(device: str) -> str:
    """Resolves and validates the device path, returning the resolved path
    to use for the actual mtools call. Raises ValidationError on any
    failure - never partially trusts the input."""
    resolved = os.path.realpath(device)
    if not resolved.startswith("/dev/"):
        raise ValidationError(f"{device} n'est pas un peripherique bloc")

    row = _lsblk_row(resolved)

    if row.get("type") != "part":
        raise ValidationError(f"{resolved} n'est pas une partition")

    if not is_removable(row):
        raise ValidationError(f"{resolved} n'est pas identifie comme amovible")

    fstype = (row.get("fstype") or "").lower()
    if fstype in NON_DOS_FSTYPES:
        raise ValidationError(f"{resolved} n'est pas une partition DOS (fstype={fstype!r})")

    if row.get("mountpoint"):
        raise ValidationError(f"{resolved} est deja monte par le noyau ({row['mountpoint']})")

    return resolved


def _invoking_pwd_entry():
    uid = os.environ.get("PKEXEC_UID")
    if uid is None:
        return None
    try:
        return pwd.getpwuid(int(uid))
    except (ValueError, KeyError):
        return None


def _invoking_home_dir() -> str | None:
    pw = _invoking_pwd_entry()
    return pw.pw_dir if pw else None


def _invoking_identity() -> tuple[int, int, str] | None:
    pw = _invoking_pwd_entry()
    return (pw.pw_uid, pw.pw_gid, pw.pw_name) if pw else None


def _invoking_username() -> str | None:
    pw = _invoking_pwd_entry()
    return pw.pw_name if pw else None


def _extra_allowed_roots(username: str | None) -> tuple[str, ...]:
    """/media and /run/media follow the desktop-automount convention of
    one subdirectory per user; scoping them to the invoking user's own
    name stops this helper from touching another local user's already-
    mounted media. /mnt is handled separately (see MNT_ROOT)."""
    if not username:
        return ()
    return (f"/media/{username}", f"/run/media/{username}")


def _is_on_removable_volume(path: str) -> bool:
    """True if `path` is stored on a removable block device (lsblk AND
    sysfs agree, as for the target device). Used for /mnt, where a
    removable volume mounted by hand is legitimate but the internal
    disk, a network share or anything else is not."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    major, minor = os.major(st.st_dev), os.minor(st.st_dev)
    sys_dev = os.path.realpath(f"/sys/dev/block/{major}:{minor}")
    if not os.path.isdir(sys_dev):
        return False  # not backed by a block device (tmpfs, NFS, overlay...)
    name = os.path.basename(sys_dev)
    try:
        row = _lsblk_row(f"/dev/{name}")
    except ValidationError:
        return False
    # An unpartitioned medium (a "superfloppy" USB stick) is its own disk:
    # it has no parent, so sysfs is checked on the device itself.
    return row.get("rm") is True and _sysfs_removable(row.get("pkname") or name)


def _is_under(path: str, root: str) -> bool:
    return path == root or path.startswith(root + os.sep)


def is_allowed_unix_path(
    path: str,
    home_dir: str | None,
    extra_roots=EXTRA_ALLOWED_ROOTS,
    removable_volume_fn=None,
) -> bool:
    resolved = os.path.realpath(path)
    if home_dir and _is_under(resolved, os.path.realpath(home_dir)):
        return True
    if any(_is_under(resolved, root) for root in extra_roots):
        return True
    if _is_under(resolved, MNT_ROOT):
        # Same late-binding trick as is_removable's sysfs_read_fn.
        check = removable_volume_fn or _is_on_removable_volume
        return check(resolved)
    return False


def validate_args(
    op: str,
    args: list[str],
    home_dir: str | None = None,
    extra_roots: tuple[str, ...] | None = None,
) -> list[str]:
    """Returns the argument list to actually pass to the mtools binary
    (Unix-side paths are replaced by their resolved realpath), or raises
    ValidationError."""
    if home_dir is None:
        home_dir = _invoking_home_dir()
    if extra_roots is None:
        extra_roots = _extra_allowed_roots(_invoking_username())

    resolved_args = []
    for arg in args:
        if arg.startswith("::"):
            resolved_args.append(arg)
            continue
        if arg.startswith("-"):
            # No flags are expected from the GUI today; reject rather than
            # silently pass through something unvalidated.
            raise ValidationError(f"argument non reconnu : {arg}")
        if op != "mcopy":
            raise ValidationError(
                f"{op} n'accepte que des chemins '::' internes a l'image, recu : {arg}"
            )
        if not is_allowed_unix_path(arg, home_dir, extra_roots):
            raise ValidationError(f"chemin Unix non autorise : {arg}")
        resolved_args.append(os.path.realpath(arg))
    return resolved_args


# -- Unix-side transfers, as the invoking user ---------------------------------

class TransferError(Exception):
    pass


# Both scripts run in a child process that has already dropped to the
# invoking user (see _user_preexec), with `python3 -I` (isolated: ignores
# PYTHON* variables, the user's site-packages and the current directory).

# local -> DOS: pack the given sources into a tar stream on stdout.
# Symlinks are followed (as mcopy itself would), with the user's rights.
_PACK_SCRIPT = """
import os, sys, tarfile
with tarfile.open(fileobj=sys.stdout.buffer, mode="w|", dereference=True) as tar:
    for src in sys.argv[1:]:
        tar.add(src, arcname=os.path.basename(src.rstrip("/")))
"""

# DOS -> local: unpack the tar stream from stdin into the destination.
# The stream comes from root's own staging directory, so it is trusted,
# but members are still checked the same way as in _checked_members.
_UNPACK_SCRIPT = """
import os, posixpath, sys, tarfile
dest = sys.argv[1]
def members(tar):
    for m in tar:
        name = posixpath.normpath(m.name)
        if not (m.isreg() or m.isdir()) or name.startswith(("/", "..")) or "/../" in "/" + name + "/":
            sys.exit("unexpected entry in transfer: " + m.name)
        yield m
with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as tar:
    kwargs = {"filter": "data"} if hasattr(tarfile, "data_filter") else {}
    tar.extractall(dest, members=members(tar), **kwargs)
"""


# Python >= 3.12 (and security backports) can additionally sanitize every
# member; older interpreters rely on _checked_members alone.
_TAR_FILTER = {"filter": "data"} if hasattr(tarfile, "data_filter") else {}


def _user_preexec(identity: tuple[int, int, str]):
    uid, gid, username = identity

    def drop() -> None:
        # Order matters: supplementary groups and gid while still root,
        # uid last (after setuid, nothing else can be changed back).
        os.setgroups(os.getgrouplist(username, gid))
        os.setgid(gid)
        os.setuid(uid)

    return drop


def _user_env(home_dir: str | None) -> dict:
    return {"LC_ALL": "C", "PATH": "/usr/bin:/bin", "HOME": home_dir or "/"}


def _checked_members(tar, expected_top: set[str]):
    """Members of a tar stream produced by the *unprivileged* side, about
    to be extracted by root: plain files and directories only, under one
    of the expected top-level names, nothing absolute or going up."""
    for member in tar:
        name = posixpath.normpath(member.name)
        parts = name.split("/")
        if (
            not (member.isreg() or member.isdir())
            or name.startswith("/")
            or ".." in parts
            or parts[0] not in expected_top
        ):
            raise TransferError(f"element inattendu dans le transfert : {member.name!r}")
        # Root must not take ownership or mode bits (setuid...) from the
        # stream: staging content is root's, plain permissions only.
        member.uid = member.gid = 0
        member.uname = member.gname = "root"
        member.mode = 0o755 if member.isdir() else 0o644
        yield member


def _start_watchdog(proc, timeout: int, flag: dict) -> threading.Timer:
    def kill() -> None:
        flag["timed_out"] = True
        proc.kill()

    timer = threading.Timer(timeout, kill)
    timer.daemon = True
    timer.start()
    return timer


def _child_failure(proc, stderr_file) -> TransferError:
    stderr_file.seek(0)
    detail = stderr_file.read().decode("utf-8", "replace").strip().splitlines()
    last = detail[-1] if detail else f"code {proc.returncode}"
    return TransferError(f"transfert cote utilisateur en echec : {last}")


def _pull_from_user(sources: list[str], staging: str, identity, home_dir, timeout: int) -> None:
    """Have the user-side child pack `sources`, unpack them into staging."""
    expected = {os.path.basename(s.rstrip("/")) for s in sources}
    with tempfile.TemporaryFile() as stderr_file:
        proc = subprocess.Popen(
            [sys.executable, "-I", "-c", _PACK_SCRIPT, *sources],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=stderr_file,
            preexec_fn=_user_preexec(identity),
            env=_user_env(home_dir),
            cwd="/",
        )
        flag = {}
        timer = _start_watchdog(proc, timeout, flag)
        try:
            try:
                with tarfile.open(fileobj=proc.stdout, mode="r|") as tar:
                    tar.extractall(staging, members=_checked_members(tar, expected), **_TAR_FILTER)
            except tarfile.TarError as exc:
                if proc.wait() == 0 and not flag:
                    raise TransferError(f"flux de transfert illisible : {exc}") from exc
            finally:
                proc.stdout.close()
            proc.wait()
        finally:
            timer.cancel()
        if flag:
            raise subprocess.TimeoutExpired(proc.args, timeout)
        if proc.returncode != 0:
            raise _child_failure(proc, stderr_file)


def _push_to_user(staging: str, dest_dir: str, identity, home_dir, timeout: int) -> None:
    """Pack staging (root's own private copy) and stream it to a
    user-side child that unpacks it into dest_dir."""
    with tempfile.TemporaryFile() as stderr_file:
        proc = subprocess.Popen(
            [sys.executable, "-I", "-c", _UNPACK_SCRIPT, dest_dir],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=stderr_file,
            preexec_fn=_user_preexec(identity),
            env=_user_env(home_dir),
            cwd="/",
        )
        flag = {}
        timer = _start_watchdog(proc, timeout, flag)
        try:
            try:
                with tarfile.open(fileobj=proc.stdin, mode="w|") as tar:
                    for name in sorted(os.listdir(staging)):
                        tar.add(os.path.join(staging, name), arcname=name)
            except BrokenPipeError:
                pass  # the child gave up early: its exit code says why
            finally:
                try:
                    proc.stdin.close()
                except BrokenPipeError:
                    pass
            proc.wait()
        finally:
            timer.cancel()
        if flag:
            raise subprocess.TimeoutExpired(proc.args, timeout)
        if proc.returncode != 0:
            raise _child_failure(proc, stderr_file)


def classify_mcopy(args: list[str]) -> str:
    """'dos' (both sides on the device), 'to_dos' (Unix sources, DOS
    target) or 'from_dos' (DOS sources, Unix target directory)."""
    if len(args) < 2:
        raise UsageError("mcopy attend au moins une source et une destination")
    *sources, target = args
    sources_dos = [s.startswith("::") for s in sources]
    if target.startswith("::"):
        if all(sources_dos):
            return "dos"
        if not any(sources_dos):
            names = [os.path.basename(s.rstrip("/")) for s in sources]
            if len(set(names)) != len(names) or not all(names):
                raise ValidationError("sources locales en double ou sans nom")
            return "to_dos"
    elif all(sources_dos):
        return "from_dos"
    raise ValidationError("melange de sources locales et DOS dans un meme mcopy")


def _run_mtools(command: list[str], timeout: int):
    return subprocess.run(command, capture_output=True, text=True, env=HELPER_ENV, timeout=timeout)


def run_mcopy_via_staging(
    device: str, direction: str, args: list[str], identity, home_dir
) -> subprocess.CompletedProcess:
    """mcopy with the Unix side handled by the invoking user - see the
    module docstring. Returns mcopy's CompletedProcess, or raises
    TransferError / subprocess.TimeoutExpired."""
    if identity is None:
        raise ValidationError("utilisateur appelant inconnu (PKEXEC_UID absent)")
    timeout = MTOOLS_COPY_TIMEOUT_SECONDS
    staging = tempfile.mkdtemp(prefix="mtools-gui-", dir=STAGING_PARENT)
    try:
        *sources, target = args
        if direction == "to_dos":
            _pull_from_user(sources, staging, identity, home_dir, timeout)
            staged = [os.path.join(staging, os.path.basename(s.rstrip("/"))) for s in sources]
            return _run_mtools(
                [ALLOWED_OPS["mcopy"], "-i", device, "-s", *staged, target], timeout
            )
        proc = _run_mtools(
            [ALLOWED_OPS["mcopy"], "-i", device, "-s", *sources, staging + "/"], timeout
        )
        if proc.returncode == 0:
            _push_to_user(staging, target, identity, home_dir, timeout)
        return proc
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print("USAGE_ERROR: usage: mtools-gui-helper <op> <device> [args...]", file=sys.stderr)
        return 3

    op, device, *args = argv[1:]

    if op not in ALLOWED_OPS:
        print(f"USAGE_ERROR: operation non autorisee : {op}", file=sys.stderr)
        return 3

    home_dir = _invoking_home_dir()
    extra_roots = _extra_allowed_roots(_invoking_username())

    try:
        resolved_device = validate_device(device)
        resolved_args = validate_args(op, args, home_dir=home_dir, extra_roots=extra_roots)
    except ValidationError as exc:
        print(f"VALIDATION_ERROR: {exc}", file=sys.stderr)
        return 2
    except UsageError as exc:
        print(f"USAGE_ERROR: {exc}", file=sys.stderr)
        return 3

    binary = ALLOWED_OPS[op]
    timeout = MTOOLS_COPY_TIMEOUT_SECONDS if op == "mcopy" else MTOOLS_TIMEOUT_SECONDS

    if op == "mcopy":
        try:
            direction = classify_mcopy(resolved_args)
        except ValidationError as exc:
            print(f"VALIDATION_ERROR: {exc}", file=sys.stderr)
            return 2
        except UsageError as exc:
            print(f"USAGE_ERROR: {exc}", file=sys.stderr)
            return 3
        if direction != "dos":
            try:
                proc = run_mcopy_via_staging(
                    resolved_device, direction, resolved_args, _invoking_identity(), home_dir
                )
            except ValidationError as exc:
                print(f"VALIDATION_ERROR: {exc}", file=sys.stderr)
                return 2
            except TransferError as exc:
                print(str(exc), file=sys.stderr)
                return 1
            except subprocess.TimeoutExpired:
                print(f"TIMEOUT_ERROR: mcopy n'a pas repondu apres {timeout}s", file=sys.stderr)
                return 4
            except OSError as exc:
                print(f"USAGE_ERROR: transfert impossible : {exc}", file=sys.stderr)
                return 3
            sys.stdout.write(proc.stdout)
            sys.stderr.write(proc.stderr)
            return 0 if proc.returncode == 0 else 1

    # mcopy only recurses into subdirectories with -s - without it, a
    # directory source silently copies just its top-level files and
    # drops every subdirectory (confirmed against a local test image: 4
    # files across 2 subdirs copied, only 1 root-level file actually
    # appeared on the other side). -s is a no-op for a plain file source,
    # so it's always safe to add for mcopy regardless of direction.
    extra_flags = ["-s"] if op == "mcopy" else []
    command = [binary, "-i", resolved_device, *extra_flags, *resolved_args]

    try:
        proc = subprocess.run(
            command, capture_output=True, text=True, env=HELPER_ENV, timeout=timeout
        )
    except OSError as exc:
        print(f"USAGE_ERROR: impossible de lancer {binary} : {exc}", file=sys.stderr)
        return 3
    except subprocess.TimeoutExpired:
        print(f"TIMEOUT_ERROR: {binary} n'a pas repondu apres {timeout}s", file=sys.stderr)
        return 4

    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    return 0 if proc.returncode == 0 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
